<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 
    NOTE: Mastery/technique hediffs REMOVED. 
    Abilities are now granted DIRECTLY via pawn.abilities.GainAbility().
    This file only contains active buff/debuff hediffs that show during gameplay.
  -->

  <!-- ═══ DEBUFFS ═══ -->

  <HediffDef>
    <defName>DMC_DriveBurn</defName>
    <label>drive burn</label>
    <description>Burning energy from a Drive projectile. Deals continuous damage over time.</description>
    <hediffClass>DMCAbilities.Hediff_DriveBurn</hediffClass>
    <defaultLabelColor>(1.0, 0.5, 0.2)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <tendable>false</tendable>
  </HediffDef>

  <HediffDef>
    <defName>DMC_VoidSlashDebuff</defName>
    <label>void slash debuff</label>
    <description>The target has been struck by a void slash, reducing their movement speed and combat effectiveness while causing minor bleeding.</description>
    <hediffClass>DMCAbilities.Hediff_VoidSlashDebuff</hediffClass>
    <defaultLabelColor>(0.5, 0.2, 0.8)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <stages>
      <li>
        <label>void-touched</label>
        <statOffsets>
          <MoveSpeed>-2.0</MoveSpeed>
          <MeleeDodgeChance>-30</MeleeDodgeChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.5</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_SpectralWound</defName>
    <label>spectral wound</label>
    <description>Wounds inflicted by spectral swords that hinder movement and combat effectiveness.</description>
    <hediffClass>DMCAbilities.Hediff_SpectralWound</hediffClass>
    <defaultLabelColor>(0.4, 0.2, 0.6)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>-0.3</MoveSpeed>
          <MeleeDodgeChance>-0.10</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_SpectralStun</defName>
    <label>spectral paralysis</label>
    <description>Paralyzed by the overwhelming force of spectral energy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.2, 0.1, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.01</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.01</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_Stagger</defName>
    <label>staggered</label>
    <description>Momentarily staggered by a precise shot.</description>
    <hediffClass>DMCAbilities.Hediff_Stagger</hediffClass>
    <defaultLabelColor>(0.7, 0.4, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>-0.2</MoveSpeed>
          <MeleeDodgeChance>-0.05</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_SpectralShock</defName>
    <label>spectral shock</label>
    <description>Shocked by spectral energy from an exploding summoned sword.</description>
    <hediffClass>DMCAbilities.Hediff_SpectralShock</hediffClass>
    <defaultLabelColor>(0.5, 0.3, 0.8)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>false</tendable>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
        <statOffsets>
          <AimingDelayFactor>0.20</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_RedHotBurn</defName>
    <label>red hot burn</label>
    <description>Flesh is seared by infernal energy from red orbs.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1.0, 0.4, 0.2)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>5.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <tendable>true</tendable>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <statOffsets>
          <MoveSpeed>-0.3</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>2.0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
        <statOffsets>
          <MoveSpeed>-0.6</MoveSpeed>
        </statOffsets>
      </li>
      <li>
        <minSeverity>4.0</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.40</offset>
          </li>
        </capMods>
        <statOffsets>
          <MoveSpeed>-1.0</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
      <li Class="HediffCompProperties_TendDuration">
        <baseTendDurationHours>8</baseTendDurationHours>
        <severityPerDayTended>-3.0</severityPerDayTended>
      </li>
    </comps>
  </HediffDef>

  <!-- ═══ ACTIVE BUFFS (show when active) ═══ -->

  <HediffDef>
    <defName>DMC_DevilTrigger</defName>
    <label>devil trigger</label>
    <description>Devil Trigger transformation active. Demonic power flows through the user, providing enhanced combat capabilities, rapid health regeneration, damage reduction, and supernatural resilience.</description>
    <hediffClass>DMCAbilities.Hediff_DevilTrigger</hediffClass>
    <defaultLabelColor>(1.0, 0.3, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>false</tendable>
    <displayWound>true</displayWound>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>transformed</label>
        <statOffsets>
          <MeleeHitChance>20</MeleeHitChance>
          <MeleeDodgeChance>25</MeleeDodgeChance>
          <MoveSpeed>2.0</MoveSpeed>
          <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
          <ArmorRating_Heat>0.20</ArmorRating_Heat>
          <PainShockThreshold>0.30</PainShockThreshold>
          <InjuryHealingFactor>3.0</InjuryHealingFactor>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.5</MeleeDamageFactor>
          <RangedDamageFactor>1.3</RangedDamageFactor>
          <AccuracyShort>1.3</AccuracyShort>
          <AccuracyMedium>1.3</AccuracyMedium>
          <AccuracyLong>1.2</AccuracyLong>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
          <StaggerDurationFactor>0.5</StaggerDurationFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.20</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.15</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.10</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_SinDevilTrigger</defName>
    <label>sin devil trigger</label>
    <description>Sin Devil Trigger transformation active. Ultimate demonic power unleashed transcending all mortal limitations.</description>
    <hediffClass>DMCAbilities.Hediff_SinDevilTrigger</hediffClass>
    <defaultLabelColor>(0.8, 0.1, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>false</tendable>
    <displayWound>true</displayWound>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>ultimate form</label>
        <statOffsets>
          <MeleeHitChance>35</MeleeHitChance>
          <MeleeDodgeChance>50</MeleeDodgeChance>
          <MoveSpeed>6.0</MoveSpeed>
          <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.40</ArmorRating_Blunt>
          <ArmorRating_Heat>0.50</ArmorRating_Heat>
          <PainShockThreshold>0.60</PainShockThreshold>
          <InjuryHealingFactor>5.0</InjuryHealingFactor>
          <MentalBreakThreshold>-0.50</MentalBreakThreshold>
          <PathAvoidGrid>-100</PathAvoidGrid>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>2.5</MeleeDamageFactor>
          <RangedDamageFactor>2.0</RangedDamageFactor>
          <AccuracyShort>1.6</AccuracyShort>
          <AccuracyMedium>1.6</AccuracyMedium>
          <AccuracyLong>1.5</AccuracyLong>
          <IncomingDamageFactor>0.50</IncomingDamageFactor>
          <StaggerDurationFactor>0.2</StaggerDurationFactor>
          <MoveSpeed>2.0</MoveSpeed>
        </statFactors>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.30</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>0.40</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>0.30</offset>
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>0.25</offset>
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>DMC_DevilTriggerRegen</defName>
    <label>demonic regeneration</label>
    <description>Rapid healing powered by demonic energy.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 1.0, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>false</tendable>
    <displayWound>true</displayWound>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <InjuryHealingFactor>8.0</InjuryHealingFactor>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>3.0</InjuryHealingFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>0.50</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.30</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_HealPermanentWounds">
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1800</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>DMC_SinDevilTriggerRegen</defName>
    <label>ultimate regeneration</label>
    <description>Divine-level healing that approaches immortality.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.9, 1.0)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <makesSickThought>false</makesSickThought>
    <lethalSeverity>-1</lethalSeverity>
    <tendable>false</tendable>
    <displayWound>true</displayWound>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <InjuryHealingFactor>15.0</InjuryHealingFactor>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>5.0</InjuryHealingFactor>
        </statFactors>
        <capMods>
          <li>
            <capacity>BloodFiltration</capacity>
            <offset>1.0</offset>
          </li>
          <li>
            <capacity>BloodPumping</capacity>
            <offset>0.60</offset>
          </li>
          <li>
            <capacity>Breathing</capacity>
            <offset>0.50</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_HealPermanentWounds">
      </li>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3600</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

</Defs>
